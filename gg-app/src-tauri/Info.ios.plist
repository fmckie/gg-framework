<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Kleio for iPhone only. Every iOS build merges Info.plist (the desktop
      app's strings) and then this file into gen/apple/gg-app_iOS/Info.plist,
      so these values win on iOS; desktop builds never read this file. Keep
      them in step with gen/apple/project.yml.
    -->
    <key>NSCameraUsageDescription</key>
    <string>Kleio uses the camera to scan the pairing QR code from your host or computer.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Kleio uses your microphone when you talk to Kleio, or tap the mic to dictate a message.</string>
    <!--
      Built with the iOS 27 SDK, UIKit stops an app at launch unless it has
      the scene lifecycle, and tao takes that path only when this is true
      (tao's platform_impl/ios/scene.rs). An iPhone still has one scene.
    -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
    </dict>
</dict>
</plist>
