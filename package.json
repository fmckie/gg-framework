{
  "name": "gg-framework",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" && pnpm --filter gg-app lint",
    "lint:fix": "eslint \"packages/*/src/**/*.{ts,tsx}\" --fix && pnpm --filter gg-app lint:fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" && pnpm --filter gg-app format",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" && pnpm --filter gg-app format:check",
    "test": "pnpm -r test",
    "identity:audit": "node scripts/identity-audit.mjs",
    "identity:audit:report": "node scripts/identity-audit.mjs --report",
    "identity:audit:packed": "node scripts/identity-audit.mjs --packed-only",
    "verify:fixed-versions": "node scripts/verify-fixed-versions.mjs",
    "verify:versions": "node scripts/verify-fixed-versions.mjs",
    "verify:local-tools": "node --test scripts/upstream-sync.test.mjs scripts/identity-audit.test.mjs scripts/consumer-contract.test.mjs scripts/verify-ci-candidate.test.mjs",
    "verify:consumer": "node scripts/consumer-contract.mjs",
    "audit:identity": "node scripts/identity-audit.mjs",
    "audit:identity:packed": "node scripts/identity-audit.mjs --packed-only",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "marked": "^15.0.12",
    "playwright": "^1.63.0"
  }
}
