{
  "name": "gg-framework",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" && pnpm --filter matey lint && pnpm --filter gg-app lint",
    "lint:fix": "eslint \"packages/*/src/**/*.{ts,tsx}\" --fix && pnpm --filter matey lint:fix && pnpm --filter gg-app lint:fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"Matey/**/*.{ts,tsx,css,html,json,md,yml}\" && pnpm --filter gg-app format",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" \"Matey/**/*.{ts,tsx,css,html,json,md,yml}\" && pnpm --filter gg-app format:check",
    "test": "pnpm -r test",
    "identity:audit": "node scripts/identity-audit.mjs",
    "identity:audit:report": "node scripts/identity-audit.mjs --report",
    "identity:audit:packed": "node scripts/identity-audit.mjs --packed-only",
    "verify:fixed-versions": "node scripts/verify-fixed-versions.mjs",
    "verify:versions": "node scripts/verify-fixed-versions.mjs",
    "audit:identity": "node scripts/identity-audit.mjs",
    "audit:identity:packed": "node scripts/identity-audit.mjs --packed-only",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript-eslint": "^8.59.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@electron/get",
      "better-sqlite3",
      "electron",
      "esbuild",
      "onnxruntime-node"
    ],
    "overrides": {
      "global-agent": "^4.1.3",
      "ip-address": "^10.3.1",
      "protobufjs": "^7.6.1",
      "tar": "^7.5.19",
      "ws": "^8.21.0",
      "hono": "^4.13.1",
      "fast-uri": "^3.1.5",
      "picomatch": "^2.3.2"
    },
    "patchedDependencies": {
      "ink@7.0.2": "patches/ink@7.0.2.patch"
    }
  },
  "dependencies": {
    "marked": "^15.0.12",
    "playwright": "^1.60.0"
  }
}
