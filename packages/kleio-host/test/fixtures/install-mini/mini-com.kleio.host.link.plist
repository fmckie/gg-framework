<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.kleio.host.link</string>
  <key>ProgramArguments</key><array>
    <string>@HOME@/kleio-host/bin/kleio-link-host</string>
    <string>serve</string>
    <string>--state-dir</string>
    <string>@HOME@/Library/Application Support/Kleio/host</string>
    <string>--upstream</string>
    <string>127.0.0.1:8445</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/usr/bin:/bin</string>
    <key>HOME</key><string>@HOME@</string>
  </dict>
  <key>WorkingDirectory</key><string>@HOME@</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>@HOME@/Library/Application Support/Kleio/host/logs/link.out.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Application Support/Kleio/host/logs/link.err.log</string>
</dict></plist>
